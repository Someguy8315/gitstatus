# This value gets embedded in gitstatusd at build time. It is
# read by ./Makefile. `gitstatusd --version` reports it back.
#
# This value is also read by shell bindings (indirectly, through
# ./install) when using GITSTATUS_DAEMON or usrbin/gitstatusd.
gitstatus_version="v1.6.2"

# libgit2 is a build time dependency of gitstatusd. ./build and the Windows
# CMake build compile it from the deps/libgit2 submodule:
# https://github.com/Someguy8315/libgit2 (branch master),
# libgit2 1.9.7 with the gitstatusd extensions as separate commits.
